# ============================================================
# InstaStock backend settings
# 1. Copy this file to backend/.env   (same folder as this file)
# 2. Replace the placeholder values with your Aiven credentials
# 3. NEVER commit .env  (it is already in .gitignore)
# ============================================================

# Websites allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173

# ---------- PostgreSQL (Aiven) ----------
# Aiven Console -> PostgreSQL service -> Overview -> Connection information -> Service URI
DATABASE_URL=postgres://avnadmin:YOUR_PASSWORD@your-pg-host.aivencloud.com:12345/defaultdb?sslmode=require

# ---------- Apache Kafka (Aiven) ----------
# Set to false ONLY to use the local fallback (that is NOT Kafka, the UI will say so)
KAFKA_ENABLED=true
# Aiven Console -> Kafka service -> Overview -> Service URI (host:port, no https://)
KAFKA_BOOTSTRAP_SERVERS=your-kafka-host.aivencloud.com:12345
# SSL = client certificate files (Aiven default). Put the 3 downloaded files in backend/certs/
KAFKA_SECURITY_PROTOCOL=SSL
KAFKA_SSL_CAFILE=certs/ca.pem
KAFKA_SSL_CERTFILE=certs/service.cert
KAFKA_SSL_KEYFILE=certs/service.key
# Only needed if you switch to SASL_SSL instead of certificates
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_ORDER_TOPIC=order-events
KAFKA_INVENTORY_TOPIC=inventory-events

# ---------- OpenSearch (Aiven) ----------
# Set to false ONLY to use the PostgreSQL search fallback (the UI will say so)
OPENSEARCH_ENABLED=true
# Aiven Console -> OpenSearch service -> Overview -> Service URI
OPENSEARCH_URL=https://avnadmin:YOUR_PASSWORD@your-os-host.aivencloud.com:12345
OPENSEARCH_INDEX=products
